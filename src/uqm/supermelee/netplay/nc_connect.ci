// This file is part of netconnection.cpp, from where it is #included.

static void NetConnection_connected(NetConnection* conn, uqm::net::Connection connection, bool discriminant);
static void NetConnection_connectError(NetConnection* conn, std::error_code connectError);
static void NetConnection_connectionClosed(NetConnection* conn, std::error_code closeError);

////////////////////////////////////////////////////////////////////////////

static void NetConnection_go(NetConnection* conn)
{
	if (NetConnection_isConnected(conn))
	{
		return;
	}

	assert(conn->state == NetState_unconnected);
	NetConnection_setState(conn, NetState_connecting);

	const bool ipv4Only {NETPLAY == NetplayIpv4};
	if (conn->options->isServer)
	{
		const uqm::net::ListenOptions options {.port = conn->options->address.port,
											   .ipv4Only = ipv4Only,
											   .backlog = NetplayListenBacklog};
		conn->listener = uqstl::make_unique<uqm::net::Listener>(
			netplayContext(), options,
			[conn](uqm::net::Connection connection) {
				NetConnection_connected(conn, uqstl::move(connection), true);
			},
			[conn](std::error_code error) {
				NetConnection_connectError(conn, error);
			});
	}
	else
	{
		const uqm::net::ConnectOptions options {.host = conn->options->address.host,
												.service = uqstl::to_string(conn->options->address.port),
												.ipv4Only = ipv4Only,
												.timeout = uqstl::chrono::milliseconds {NetplayConnecttimeout},
												.retryDelay = uqstl::chrono::milliseconds {NetplayRetrydelay}};
		conn->connector = uqstl::make_unique<uqm::net::Connector>(
			netplayContext(), options,
			[conn](uqm::net::Connection connection) {
				NetConnection_connected(conn, uqstl::move(connection), false);
			},
			[conn](std::error_code error) {
				NetConnection_connectError(conn, error);
			});
	}
}

// Called when a connection has been established. The server has the discriminant.
static void NetConnection_connected(NetConnection* conn, uqm::net::Connection connection, bool discriminant)
{
	assert(conn->connection == nullptr);
	conn->listener.reset();
	conn->connector.reset();
	conn->connection = uqstl::make_unique<uqm::net::Connection>(uqstl::move(connection));
	conn->connection->start(
		NetplayReadbufsize,
		[conn](uqstl::span<const std::byte> data) {
			return dataReceived(conn, data);
		},
		[conn](std::error_code error) {
			NetConnection_connectionClosed(conn, error);
		});

	conn->stateFlags.discriminant = discriminant;
	conn->stateFlags.connected = true;
	NetConnection_setState(conn, NetState_init);

	(*conn->connectCallback)(conn);
}

static void NetConnection_connectError(NetConnection* conn, std::error_code connectError)
{
	conn->stateFlags.connected = false;
	conn->stateFlags.disconnected = true;
	conn->listener.reset();
	conn->connector.reset();
	NetConnection_setState(conn, NetState_unconnected);

	if (conn->errorCallback != nullptr)
	{
		const NetConnectionError error {.state = NetState_connecting, .err = connectError.value()};
		(*conn->errorCallback)(conn, &error);
	}
	NetConnection_close(conn);
}

// Called when the remote side closes the connection, or an error occurs.
static void NetConnection_connectionClosed(NetConnection* conn, std::error_code closeError)
{
	if (closeError)
	{
		uqm::log::error("NETPLAY: [{}] The connection closed: {}.", conn->player, closeError.message());
		NetConnection_doErrorCallback(conn, closeError.value());
	}
	conn->connection.reset();
	NetConnection_doClose(conn);
}
